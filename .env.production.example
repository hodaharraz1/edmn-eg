# ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════
# EDMN — PRODUCTION environment TEMPLATE (self-hosted).  NAMES AND PLACEHOLDERS ONLY.
#
#   Real file:  /etc/edmn/production.env   owner root:edmn, mode 0640 (or root:root 0600) — NEVER committed,
#               never pasted into chat, tickets or logs. Generate every secret ON THE SERVER (commands below).
#   Loaded by:  deploy/compose/docker-compose.prod.yml (env_file) for web, worker, migrate, seed, acceptance.
#   Checked by: `docker compose … run --rm acceptance` and the app itself (production boot refuses staging/test
#               secrets, staging/local databases, http URLs, placeholder senders — src/server/core/runtime-env.ts).
#
#   Markers:  [PUBLIC LAUNCH]  required before the public website opens
#             [PILOT]          required for the controlled pilot (real users, no real money)
#             [REAL MONEY]     required only before the real-money gate is ever considered (NOT part of launch)
#             [OPTIONAL]       safe to leave unset; the feature reports NOT CONFIGURED and fails closed
#
#   Optional variables are COMMENTED OUT (`# NAME=`): never leave `NAME=` empty — an empty value is not "unset"
#   (e.g. an empty SMS_DRIVER fails validation). Uncomment only when you have a value.
#   Placeholders look like  <...>  — production boot rejects anything still containing them where it can tell.
#   Generate secrets on the server:   openssl rand -base64 48    (SESSION_SECRET, CRON_SECRET, tokens)
#                                     openssl rand -base64 32    (DATA_ENCRYPTION_KEY — exactly 32 bytes)
#   Every secret must be NEW for production: the staging values are refused by fingerprint.
# ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════

# ── Core ─────────────────────────────────────────────────────────────────────────────────────────────────────────
# [PUBLIC LAUNCH] Deployment kind. Marks the database permanently on the first migration.
EDMN_ENVIRONMENT=production
# [PUBLIC LAUNCH] Set by compose too; kept here for one-off `docker run`.
NODE_ENV=production
# [OPTIONAL] info | warn | error
LOG_LEVEL=info
# [OPTIONAL] Release tag for error tracking — deploy.sh exports the image SHA; leave empty here.
# EDMN_RELEASE=

# ── URLs / hosts ─────────────────────────────────────────────────────────────────────────────────────────────────
# [PUBLIC LAUNCH]
APP_URL=https://www.edmneg.com
# [PUBLIC LAUNCH] Seller Center stays on www at launch.
SELLER_APP_URL=https://www.edmneg.com/seller
# [PUBLIC LAUNCH] Admin console on its own origin.
ADMIN_APP_URL=https://admin.edmneg.com
# [PUBLIC LAUNCH]
ADMIN_HOST=admin.edmneg.com
# [PUBLIC LAUNCH] Admin console only on ADMIN_HOST (www/admin redirects there).
ENFORCE_ADMIN_HOST=true
# [PUBLIC LAUNCH] Self-hosted behind our own nginx/Apache: trust X-Real-IP / X-Forwarded-For from it.
#   Only correct because the app port is bound to 127.0.0.1 (nothing else can reach it).
TRUSTED_PROXY=true
# [OPTIONAL] Staff session idle timeout in minutes (default 30, max 240).
ADMIN_IDLE_TIMEOUT_MINUTES=30

# ── Database ─────────────────────────────────────────────────────────────────────────────────────────────────────
# [PUBLIC LAUNCH] RUNTIME role (DML only, e.g. edmn_app). Self-hosted Postgres: host = compose service `postgres`.
#   External/managed Postgres (e.g. Neon production project): its pooled URL with sslmode=require.
#   Refused in production: localhost, the staging endpoint, database names containing test/e2e/staging/demo.
#   <PW> = the edmn_app password (EDMN_APP_PASSWORD in /etc/edmn/postgres.env), URL-encoded.
DATABASE_URL=postgres://edmn_app:<PW>@postgres:5432/edmn?sslmode=disable
# [OPTIONAL] Direct (unpooled) URL; on a self-hosted database this is the same as DATABASE_URL.
# DATABASE_URL_UNPOOLED=
#   The schema OWNER URL (edmn_owner, used ONLY by migrate/seed) lives in a separate file /etc/edmn/migrate.env
#   (<PW> there = EDMN_OWNER_PASSWORD):
#     DATABASE_URL=postgres://edmn_owner:<PW>@postgres:5432/edmn?sslmode=disable
#     DATABASE_URL_UNPOOLED=postgres://edmn_owner:<PW>@postgres:5432/edmn?sslmode=disable
# [OPTIONAL] Pool / timeout tuning (defaults are production-safe).
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# ── Encryption ───────────────────────────────────────────────────────────────────────────────────────────────────
# [PUBLIC LAUNCH] AES-256-GCM key, base64 of 32 random bytes. NEW for production. Back it up OFFLINE (sealed):
#   losing it makes national IDs, payout details and TOTP seeds unrecoverable; restore drills need it too.
DATA_ENCRYPTION_KEY=<BASE64_32_BYTES>
# [PUBLIC LAUNCH] Key id written into new ciphertexts (not "default"), e.g. prod1.
DATA_ENCRYPTION_KEY_ID=<PROD_KEY_ID>
# [OPTIONAL] Decrypt-only previous keys during a rotation: kid:base64,kid:base64
# DATA_ENCRYPTION_KEYS_PREVIOUS=

# ── Sessions ─────────────────────────────────────────────────────────────────────────────────────────────────────
# [PUBLIC LAUNCH] ≥ 48 random chars, different from every other secret.
SESSION_SECRET=<RANDOM_48+>

# ── Cron / worker ────────────────────────────────────────────────────────────────────────────────────────────────
# [PUBLIC LAUNCH] Authenticates /api/cron/tick (watchdog timer only). ≥ 24 chars, different from SESSION_SECRET.
CRON_SECRET=<RANDOM_48+>

# ── Dedicated key material (Phase 1: mobile + Protected Deal delivery codes) ─────────────────────────────────────
# [PUBLIC LAUNCH] Delivery OTP HMAC + the buyer's sealed in-app copy. ≥ 32 random chars, different from every other
# secret (never SESSION_SECRET). Rotating it invalidates only the delivery codes that are currently active.
DELIVERY_OTP_KEY=<RANDOM_48+>
# [PUBLIC LAUNCH] Signs mobile app access tokens (10-minute lifetime). ≥ 32 random chars, different from every other
# secret. Rotating it only forces apps to refresh (refresh tokens are not derived from it).
MOBILE_TOKEN_KEY=<RANDOM_48+>
# [PUBLIC LAUNCH] The dedicated `worker` container is the primary scheduler.
WORKER_DEDICATED=true
# [PUBLIC LAUNCH] Off: requests never run jobs inline (the worker does).
INLINE_WORKER=false
# [OPTIONAL] Worker poll interval (ms) and heartbeat tolerance (s) for the healthcheck.
WORKER_POLL_MS=5000
HEARTBEAT_MAX_AGE_SEC=180

# ── Storage ──────────────────────────────────────────────────────────────────────────────────────────────────────
# [PUBLIC LAUNCH] database = files live in Postgres (encrypted where sensitive) and are covered by every pg_dump.
#   (local would need a dedicated volume AND a separate file backup — not recommended.)
STORAGE_DRIVER=database

# ── SMTP (transactional email; the existing info@edmneg.com mailbox, MX and mail DNS stay untouched) ─────────────
# [PUBLIC LAUNCH]
MAIL_DRIVER=smtp
# [PUBLIC LAUNCH] Sending provider host / port (465 implicit TLS or 587 STARTTLS).
SMTP_HOST=<SMTP_HOST>
SMTP_PORT=587
# [PUBLIC LAUNCH] Provider credential (owner creates it; never shared in chat).
SMTP_USER=<SMTP_USER>
SMTP_PASSWORD=<SMTP_PASSWORD>
# [PUBLIC LAUNCH]
# (no quotes: the value is read identically by docker compose, docker --env-file and the checker)
MAIL_FROM=اضمن إي جي <info@edmneg.com>

# ── Email delivery webhook (/api/webhooks/email/resend | generic) ───────────────────────────────────────────────
# [PILOT] Signing secret from the provider dashboard (≥ 24 chars). Only way a message becomes DELIVERED/BOUNCED.
EMAIL_WEBHOOK_SECRET=<PROVIDER_WEBHOOK_SIGNING_SECRET>

# ── Error tracking ───────────────────────────────────────────────────────────────────────────────────────────────
# [PILOT] https DSN (Sentry free tier works). Internal error_events is always kept.
# ERROR_TRACKING_DSN=
# [OPTIONAL] sentry | webhook (auto-detected from the DSN)
# ERROR_TRACKING_PROVIDER=
# [OPTIONAL] Bearer token for a generic webhook tracker
# ERROR_TRACKING_TOKEN=

# ── Malware scanner (compose profile "scanner": clamd + private wrapper on the internal network) ────────────────
# [PILOT] Private files stay QUARANTINED (unopenable) until CLEAN. Plain http is accepted ONLY for a private
#   destination (single-label compose service name / RFC 1918 / loopback) with MALWARE_SCANNER_PRIVATE_NETWORK=true.
MALWARE_SCANNER_URL=http://scanner:8080/scan
MALWARE_SCANNER_PRIVATE_NETWORK=true
# [PILOT] Same value as SCANNER_TOKEN in /etc/edmn/scanner.env (≥ 32 random chars).
MALWARE_SCANNER_TOKEN=<RANDOM_48+>
# [OPTIONAL] ms; a timeout is a scan failure (file stays blocked, retried after 15 min).
MALWARE_SCANNER_TIMEOUT_MS=30000

# ── Web Push ─────────────────────────────────────────────────────────────────────────────────────────────────────
# [OPTIONAL] NEW key pair generated on the server: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@edmneg.com

# ── SMS (mobile verification, seller onboarding, Protected Deals) ───────────────────────────────────────────────
# [PILOT] Without it those flows are refused with a clear message (never faked).
# SMS_DRIVER=
# SMS_HTTP_URL=
# SMS_HTTP_TOKEN=
# SMS_SENDER_ID=

# ── Security ─────────────────────────────────────────────────────────────────────────────────────────────────────
# Always on in production regardless of these values (listed so nobody sets them to false by mistake):
#   MALWARE_SCAN_REQUIRED, OUTBOX_ENCRYPT_SECRETS
# FORBIDDEN in production (boot refuses them): PUSH_ALLOW_ANY_ENDPOINT, E2E_DATABASE_URL, TEST_DATABASE_URL,
#   E2E_BASE_URL, STAGING_DEMO_PASSWORD, STAGING_ADMIN_PASSWORD, STAGING_TOTP_SECRET, SEED_DEMO

# ── Feature / commerce gates ─────────────────────────────────────────────────────────────────────────────────────
# Real money is NOT an environment variable: it is the database setting payments.realMoneyEnabled (default false),
#   changed only through the audited Maker/Checker path, and it stays OFF.
#   Nothing in this file can enable it. The acceptance suite fails if it is ever found enabled at launch.
# [REAL MONEY] Payment provider webhook signing secret — leave EMPTY until the real-money programme starts.
# PAYMENT_WEBHOOK_SECRET=
