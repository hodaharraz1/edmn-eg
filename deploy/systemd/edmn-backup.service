# EDMN — daily encrypted database backup (deploy/scripts/backup.sh). Configuration: /etc/edmn/backup.env.
[Unit]
Description=EDMN daily encrypted PostgreSQL backup
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=root
EnvironmentFile=-/etc/edmn/compose.env
ExecStart=/opt/edmn/deploy/scripts/backup.sh --reason daily
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=3h
