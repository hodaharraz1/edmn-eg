# EDMN — scheduler watchdog tick (optional safety net; the worker container is the primary scheduler).
# Due-based + database leases: running alongside the worker never runs a job twice; jobs never move money.
[Unit]
Description=EDMN scheduler watchdog tick
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=root
# Reads /etc/edmn/cron-header (0600 root). Calls only 127.0.0.1:${EDMN_WEB_PORT}.
EnvironmentFile=-/etc/edmn/compose.env
ExecStart=/opt/edmn/deploy/scripts/tick.sh
TimeoutStartSec=70
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
