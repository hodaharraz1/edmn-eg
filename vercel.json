{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/tick",
      "schedule": "17 3 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "followup-02": false,
      "claude/edmn-mobile-integration": false,
      "codex/mobile-audit-fixes": false,
      "claude/mobile-phase6-notifications": false,
      "claude/mobile-unified-integration": false,
      "claude/**": false,
      "codex/**": false
    }
  }
}
