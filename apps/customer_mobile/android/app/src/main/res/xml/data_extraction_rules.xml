<?xml version="1.0" encoding="utf-8"?>
<!-- Policy SEC-122/123 (MASVS-STORAGE): no app data in cloud backups or device-to-device transfers.
     The session lives in Keystore-backed storage whose keys never leave the device; a restored copy is useless
     and would only break sign-in. Users simply sign in again on a new device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
