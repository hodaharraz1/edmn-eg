# ─────────────────────────────────────────────────────────────
# EDMN Marketplace — environment template (placeholders only)
# Copy to .env.local for development. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# Public URLs of the three surfaces. In development all three are served by the
# same Next.js process: customer at /, seller center at /seller, admin at /admin.
APP_URL=http://localhost:3000
SELLER_APP_URL=http://localhost:3000/seller
ADMIN_APP_URL=http://localhost:3000/admin
# When true, requests are routed by Host header (seller.* -> /seller, admin.* -> /admin)
# and /seller, /admin paths are blocked on the customer host. Enable in production.
ENFORCE_HOSTS=false
SELLER_HOST=seller.edmneg.com
ADMIN_HOST=admin.edmneg.com

# PostgreSQL 14+ (16 recommended)
DATABASE_URL=postgresql://edmn:edmn@localhost:5432/edmn_dev
DATABASE_POOL_MAX=10
# Used only by the automated test suite (it is wiped by tests!)
TEST_DATABASE_URL=postgresql://edmn:edmn@localhost:5432/edmn_test
# Used only by the Playwright E2E suite (reset and re-seeded on every run!)
E2E_DATABASE_URL=postgresql://edmn:edmn@localhost:5432/edmn_e2e

# 32-byte keys, base64. Generate with:  openssl rand -base64 32
# SESSION_SECRET signs tokens; DATA_ENCRYPTION_KEY encrypts national IDs, payout details, TOTP secrets.
SESSION_SECRET=replace-with-openssl-rand-base64-32
DATA_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# Sessions
SESSION_TTL_HOURS=720
ADMIN_SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# File storage: "local" (disk). Private and public roots are kept separate.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
UPLOAD_MAX_IMAGE_MB=8
UPLOAD_MAX_DOCUMENT_MB=10

# Email: "log" (development — stored in outbound_messages and printed) or "smtp"
MAIL_DRIVER=log
MAIL_FROM="EDMN <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# SMS: "log" (development) or "http" (generic provider webhook — fill in when a provider is contracted)
SMS_DRIVER=log
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER_ID=EDMN

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Background worker poll interval (ms)
WORKER_POLL_MS=5000

# Official logo: path under /public or absolute URL. Leave empty to show the neutral placeholder.
NEXT_PUBLIC_LOGO_URL=

# ── Production infrastructure providers (all optional; absent = honest NOT_CONFIGURED) ──
# See docs/runbooks/PRODUCTION_INFRASTRUCTURE.md. Never commit real values.
# MAIL_FROM="اضمن إي جي <info@edmneg.com>"
# VAPID_SUBJECT=mailto:info@edmneg.com
# ERROR_TRACKING_DSN=            # Sentry DSN or https webhook URL
# ERROR_TRACKING_PROVIDER=       # sentry | webhook (auto-detected)
# ERROR_TRACKING_TOKEN=          # Bearer token for a generic webhook tracker
# EMAIL_WEBHOOK_SECRET=          # delivery webhook signing secret (Resend whsec_… or generic relay)
# MALWARE_SCANNER_URL=           # https://<private-scanner>/scan
# MALWARE_SCANNER_TOKEN=         # same value as the wrapper's SCANNER_TOKEN
# MALWARE_SCANNER_TIMEOUT_MS=30000
# ADMIN_APP_URL=https://admin.edmneg.com   # required in production (host must equal ADMIN_HOST)
