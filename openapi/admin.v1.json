{
  "openapi": "3.1.0",
  "info": {
    "title": "EDMN Admin App API",
    "description": "Admin App (staff only). Every admin API requires a TOTP-verified session; sensitive actions require fresh 2FA (step-up). Phase 1 exposes no financial mutation.",
    "version": "1.0.0-phase1"
  },
  "servers": [
    {
      "url": "https://edmneg.com",
      "description": "Production (Real Money OFF)"
    }
  ],
  "paths": {
    "/api/v1/admin/auth/login": {
      "post": {
        "operationId": "adminLogin",
        "summary": "Staff sign-in (returns a pre-MFA session)",
        "tags": [
          "Admin Auth"
        ],
        "security": [],
        "parameters": [
          {
            "name": "X-EDMN-Installation",
            "in": "header",
            "required": false,
            "description": "App installation id (per-installation rate limits).",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{16,128}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "identifier": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 200
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "device": {
                    "$ref": "#/components/schemas/DeviceInfo"
                  }
                },
                "required": [
                  "identifier",
                  "password",
                  "device"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResult"
                }
              }
            }
          },
          "401": {
            "description": "Problem: unauthenticated",
            "x-error-codes": [
              "unauthenticated"
            ],
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Problem: validation_failed",
            "x-error-codes": [
              "validation_failed"
            ],
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Problem: rate_limited",
            "x-error-codes": [
              "rate_limited"
            ],
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Problem: internal_error",
            "x-error-codes": [
              "internal_error"
            ],
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-auth-mode": "none",
        "x-rate-limit": {
          "tier": "auth",
          "perUser": [
            20,
            300
          ],
          "perInstallation": [
            20,
            300
          ],
          "perIp": [
            300,
            300
          ]
        }
      }
    },
