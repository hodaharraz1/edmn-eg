          "installationId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{16,128}$",
            "description": "Random per-installation id generated by the app and kept in secure storage."
          },
          "platform": {
            "type": "string",
            "enum": [
              "IOS",
              "ANDROID"
            ]
          },
          "deviceName": {
            "type": "string",
            "maxLength": 80
          },
          "appVersion": {
            "type": "string",
            "pattern": "^[0-9A-Za-z.+_-]{1,32}$"
          }
        },
        "required": [
          "installationId",
          "platform"
        ]
      },
      "DeviceSession": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Opaque session handle (not the session secret)."
          },
          "scope": {
            "type": "string",
            "enum": [
              "WEB",
              "ADMIN",
              "MOBILE",
              "ADMIN_MOBILE"
            ]
          },
          "current": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastSeenAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "device": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "platform": {
                    "type": "string"
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "appVersion": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "app": {
                    "type": "string"
                  }
                },
                "required": [
                  "platform",
                  "name",
                  "appVersion",
                  "app"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "userAgent": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "scope",
          "current",
          "createdAt",
          "lastSeenAt",
          "expiresAt",
          "device",
